post_install() {
  cat <<'EOF'
Wacom CTL-4100 userspace driver installed.

Required once:
  sudo usermod -aG input "$USER"
  (log out and back in so the new group applies)

Then enable the daemon:
  systemctl --user enable --now wacomd

The udev rule unbinds the in-kernel `wacom` driver for this tablet so pen
events are not duplicated. Reconnect the tablet after installation.
EOF
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=hid 2>/dev/null || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl --user disable --now wacomd 2>/dev/null || true
}
