# Local development PKGBUILD. Builds the workspace next to this file, so it
# works from a clone without publishing a release tarball:
#
#   cd packaging && makepkg -si
#
pkgname=wacom-ctl4100
pkgver=0.1.0
pkgrel=15
pkgdesc="Native userspace driver and companion app for the Wacom Intuos S (CTL-4100)"
arch=('x86_64' 'aarch64')
url="https://github.com/vituxdxd/wacom-ctl4100-omarchy"
license=('MIT')
depends=('gcc-libs' 'hidapi')
makedepends=('cargo' 'rust')
install=wacom-ctl4100.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --release --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/wacomd "$pkgdir/usr/bin/wacomd"
  install -Dm755 target/release/wacomctl "$pkgdir/usr/bin/wacomctl"
  install -Dm755 target/release/wacom-gui "$pkgdir/usr/bin/wacom-gui"

  install -Dm644 packaging/70-wacom-ctl4100.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-wacom-ctl4100.rules"
  install -Dm644 packaging/wacomd.service \
    "$pkgdir/usr/lib/systemd/user/wacomd.service"
  install -Dm644 packaging/wacom-gui.desktop \
    "$pkgdir/usr/share/applications/wacom-gui.desktop"

  install -Dm644 packaging/modules-load.conf \
    "$pkgdir/usr/lib/modules-load.d/wacom-ctl4100.conf"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/RE_REPORT_CTL4100.md \
    "$pkgdir/usr/share/doc/$pkgname/RE_REPORT_CTL4100.md"
}
