[Unit]
Description=Wacom Intuos S (CTL-4100) userspace driver
Documentation=file:/usr/share/doc/wacom-ctl4100/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wacomd
Restart=on-failure
RestartSec=2
# Access to hidraw/uinput comes from 70-wacom-ctl4100.rules (uaccess).

[Install]
WantedBy=graphical-session.target
